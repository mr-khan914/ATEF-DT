<mxfile host="app.diagrams.net">
  <diagram name="ATEF-DT framework" id="atefdt-framework">
    <mxGraphModel dx="1600" dy="1000" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1696" pageHeight="1020" math="1" shadow="0" background="#FFFFFF">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="c3" value="" style="rounded=1;arcSize=2;fillColor=#EEF3F9;strokeColor=#2F5F8F;strokeWidth=1.4;html=1;" vertex="1" parent="1">
          <mxGeometry x="20.0" y="20.0" width="372.0" height="884.0" as="geometry" />
        </mxCell>
        <mxCell id="c4" value="&lt;div style=&quot;font-size:20px;font-weight:bold;color:#2F5F8F;line-height:1.15&quot;&gt;(A) Patient-Centric&lt;br&gt;Digital Twin&lt;/div&gt;&lt;div style=&quot;font-size:17px;color:#5B6670;margin-top:4px&quot;&gt;edge node of patient \(p\)&lt;/div&gt;" style="text;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;html=1;whiteSpace=wrap;fontFamily=Helvetica;fontColor=#1F2933;" vertex="1" parent="1">
          <mxGeometry x="66.0" y="26.0" width="280.0" height="80.0" as="geometry" />
        </mxCell>
        <mxCell id="c5" value="" style="shape=line;strokeColor=#2F5F8F;strokeWidth=1;opacity=45;html=1;" vertex="1" parent="1">
          <mxGeometry x="38.0" y="112.0" width="336.0" height="1.0" as="geometry" />
        </mxCell>
        <mxCell id="c6" value="&lt;div style=&quot;font-size:18px;font-weight:bold;color:#1F2933;margin-bottom:6px&quot;&gt;Wearable sensing&lt;/div&gt;&lt;div style=&quot;font-size:17px;line-height:34px&quot;&gt;\(\mathbf{y}_p=\mathbf{x}_p+\mathbf{v}_p\)&lt;/div&gt;&lt;div style=&quot;font-size:15.5px;color:#5B6670;margin-top:3px&quot;&gt;measurements may be missing&lt;/div&gt;" style="rounded=1;arcSize=5;fillColor=#FFFFFF;strokeColor=#2F5F8F;strokeWidth=1.1;align=center;verticalAlign=middle;spacing=4;html=1;whiteSpace=wrap;fontFamily=Helvetica;fontColor=#1F2933;" vertex="1" parent="1">
          <mxGeometry x="36.0" y="128.0" width="340.0" height="106.0" as="geometry" />
        </mxCell>
        <mxCell id="c7" value="&lt;div style=&quot;font-size:18px;font-weight:bold;color:#1F2933;margin-bottom:6px&quot;&gt;Predictor–corrector twin&lt;/div&gt;&lt;div style=&quot;font-size:17px;line-height:34px&quot;&gt;\(\hat{\mathbf{x}}_p=\hat{\mathbf{x}}_p^{-}+\mathbf{K}_p\big(\mathbf{y}_p-\hat{\mathbf{x}}_p^{-}\big)\)&lt;/div&gt;&lt;div style=&quot;font-size:15.5px;color:#5B6670;margin-top:3px&quot;&gt;local-level model \(\mathbf{A}_p=\mathbf{I}\), \(\mathbf{Q}_p\) by moments&lt;/div&gt;" style="rounded=1;arcSize=5;fillColor=#FFFFFF;strokeColor=#2F5F8F;strokeWidth=1.1;align=center;verticalAlign=middle;spacing=4;html=1;whiteSpace=wrap;fontFamily=Helvetica;fontColor=#1F2933;" vertex="1" parent="1">
          <mxGeometry x="36.0" y="262.0" width="340.0" height="114.0" as="geometry" />
        </mxCell>
        <mxCell id="c8" value="&lt;div style=&quot;font-size:18px;font-weight:bold;color:#1F2933;margin-bottom:6px&quot;&gt;Acuity and sensing duty&lt;/div&gt;&lt;div style=&quot;font-size:17px;line-height:34px&quot;&gt;\(a_p=\min\{1,\tfrac{1}{3}\|\hat{\mathbf{x}}_p\|_\infty\}\)&lt;/div&gt;&lt;div style=&quot;font-size:17px;line-height:34px&quot;&gt;\(\delta(a_p)=\delta_{\min}+(1-\delta_{\min})\,a_p\)&lt;/div&gt;" style="rounded=1;arcSize=5;fillColor=#FFFFFF;strokeColor=#2F5F8F;strokeWidth=1.1;align=center;verticalAlign=middle;spacing=4;html=1;whiteSpace=wrap;fontFamily=Helvetica;fontColor=#1F2933;" vertex="1" parent="1">
          <mxGeometry x="36.0" y="404.0" width="340.0" height="148.0" as="geometry" />
        </mxCell>
        <mxCell id="c9" value="&lt;div style=&quot;font-size:18px;font-weight:bold;color:#1F2933;margin-bottom:6px&quot;&gt;Monitoring-energy forecast&lt;/div&gt;&lt;div style=&quot;font-size:17px;line-height:34px&quot;&gt;\(\widehat{M}_p=P_{\mathrm{mon}}\Delta t\sum_{j=0}^{H-1}\delta\big(a(\mathbf{A}_p^{j}\hat{\mathbf{x}}_p)\big)\)&lt;/div&gt;" style="rounded=1;arcSize=5;fillColor=#FFFFFF;strokeColor=#2F5F8F;strokeWidth=1.1;align=center;verticalAlign=middle;spacing=4;html=1;whiteSpace=wrap;fontFamily=Helvetica;fontColor=#1F2933;" vertex="1" parent="1">
          <mxGeometry x="36.0" y="580.0" width="340.0" height="106.0" as="geometry" />
        </mxCell>
        <mxCell id="c10" value="&lt;div style=&quot;font-size:18px;font-weight:bold;color:#1F2933;margin-bottom:6px&quot;&gt;State report&lt;/div&gt;&lt;div style=&quot;font-size:17px;line-height:34px&quot;&gt;\(\big(C_p,\,h_p,\,\kappa_p,\,N_p,\,\widehat{M}_p\big)\)&lt;/div&gt;" style="rounded=1;arcSize=5;fillColor=#FFFFFF;strokeColor=#2F5F8F;strokeWidth=1.1;align=center;verticalAlign=middle;spacing=4;html=1;whiteSpace=wrap;fontFamily=Helvetica;fontColor=#1F2933;" vertex="1" parent="1">
          <mxGeometry x="36.0" y="714.0" width="340.0" height="174.0" as="geometry" />
        </mxCell>
        <mxCell id="c11" value="" style="rounded=1;arcSize=2;fillColor=#FBF6EC;strokeColor=#8C6418;strokeWidth=1.4;html=1;" vertex="1" parent="1">
          <mxGeometry x="448.0" y="20.0" width="372.0" height="884.0" as="geometry" />
        </mxCell>
        <mxCell id="c12" value="&lt;div style=&quot;font-size:20px;font-weight:bold;color:#8C6418;line-height:1.15&quot;&gt;(B) Energy-Aware&lt;br&gt;Client Selection&lt;/div&gt;&lt;div style=&quot;font-size:17px;color:#5B6670;margin-top:4px&quot;&gt;federation server&lt;/div&gt;" style="text;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;html=1;whiteSpace=wrap;fontFamily=Helvetica;fontColor=#1F2933;" vertex="1" parent="1">
          <mxGeometry x="494.0" y="26.0" width="280.0" height="80.0" as="geometry" />
        </mxCell>
        <mxCell id="c13" value="" style="shape=line;strokeColor=#8C6418;strokeWidth=1;opacity=45;html=1;" vertex="1" parent="1">
          <mxGeometry x="466.0" y="112.0" width="336.0" height="1.0" as="geometry" />
        </mxCell>
        <mxCell id="c14" value="&lt;div style=&quot;font-size:18px;font-weight:bold;color:#1F2933;margin-bottom:6px&quot;&gt;Bit-width assignment&lt;/div&gt;&lt;div style=&quot;font-size:17px;line-height:34px&quot;&gt;\(b_p=\Pi_{[b_{\min},b_{\max}]}\big\lceil b_{\max}\,\psi^{\gamma_b}\,m_p\big\rceil\)&lt;/div&gt;&lt;div style=&quot;font-size:15.5px;color:#5B6670;margin-top:3px&quot;&gt;\(m_p\) from channel gain and battery&lt;/div&gt;" style="rounded=1;arcSize=5;fillColor=#FFFFFF;strokeColor=#8C6418;strokeWidth=1.1;align=center;verticalAlign=middle;spacing=4;html=1;whiteSpace=wrap;fontFamily=Helvetica;fontColor=#1F2933;" vertex="1" parent="1">
          <mxGeometry x="464.0" y="128.0" width="340.0" height="106.0" as="geometry" />
        </mxCell>
        <mxCell id="c15" value="&lt;div style=&quot;font-size:18px;font-weight:bold;color:#1F2933;margin-bottom:6px&quot;&gt;Round-energy prediction&lt;/div&gt;&lt;div style=&quot;font-size:17px;line-height:34px&quot;&gt;\(\hat{e}_p=e_p^{\mathrm{cmp}}+e_p^{\mathrm{ul}}(b_p)+e_p^{\mathrm{dl}}\)&lt;/div&gt;" style="rounded=1;arcSize=5;fillColor=#FFFFFF;strokeColor=#8C6418;strokeWidth=1.1;align=center;verticalAlign=middle;spacing=4;html=1;whiteSpace=wrap;fontFamily=Helvetica;fontColor=#1F2933;" vertex="1" parent="1">
          <mxGeometry x="464.0" y="262.0" width="340.0" height="114.0" as="geometry" />
        </mxCell>
        <mxCell id="c16" value="&lt;div style=&quot;font-size:18px;font-weight:bold;color:#1F2933;margin-bottom:6px&quot;&gt;Feasibility screen \(\mathcal{F}^{(r)}\)&lt;/div&gt;&lt;div style=&quot;font-size:17px;line-height:34px&quot;&gt;\(\vartheta_p\ge \vartheta_{\min}\)&amp;nbsp; (no outage)&lt;/div&gt;&lt;div style=&quot;font-size:17px;line-height:34px&quot;&gt;\(C_p-\hat{e}_p-\widehat{M}_p\ge C_{\mathrm{res}}\)&lt;/div&gt;&lt;div style=&quot;font-size:17px;line-height:34px&quot;&gt;\(\rho_p\ge\rho_{\min}\)&lt;/div&gt;" style="rounded=1;arcSize=5;fillColor=#FFFFFF;strokeColor=#8C6418;strokeWidth=1.1;align=center;verticalAlign=middle;spacing=4;html=1;whiteSpace=wrap;fontFamily=Helvetica;fontColor=#1F2933;" vertex="1" parent="1">
          <mxGeometry x="464.0" y="404.0" width="340.0" height="148.0" as="geometry" />
        </mxCell>
        <mxCell id="c17" value="&lt;div style=&quot;font-size:18px;font-weight:bold;color:#1F2933;margin-bottom:6px&quot;&gt;Composite score&lt;/div&gt;&lt;div style=&quot;font-size:17px;line-height:34px&quot;&gt;\(s_p=\tilde{e}_p^{\,\lambda_E}\,\tilde{u}_p^{\,\lambda_F}\,\tilde{t}_p^{\,\lambda_T}\)&lt;/div&gt;&lt;div style=&quot;font-size:15.5px;color:#5B6670;margin-top:3px&quot;&gt;energy · participation · trust&lt;/div&gt;" style="rounded=1;arcSize=5;fillColor=#FFFFFF;strokeColor=#8C6418;strokeWidth=1.1;align=center;verticalAlign=middle;spacing=4;html=1;whiteSpace=wrap;fontFamily=Helvetica;fontColor=#1F2933;" vertex="1" parent="1">
          <mxGeometry x="464.0" y="580.0" width="340.0" height="106.0" as="geometry" />
        </mxCell>
        <mxCell id="c18" value="&lt;div style=&quot;font-size:18px;font-weight:bold;color:#1F2933;margin-bottom:6px&quot;&gt;Top-\(k_r\) selection&lt;/div&gt;&lt;div style=&quot;font-size:17px;line-height:34px&quot;&gt;\(\mathcal{S}^{(r)}\): the \(k_r\) feasible clients&lt;/div&gt;&lt;div style=&quot;font-size:17px;line-height:34px&quot;&gt;with the smallest \(s_p\)&lt;/div&gt;&lt;div style=&quot;font-size:15.5px;color:#5B6670;margin-top:3px&quot;&gt;\(k_r=\min\{S_{\max},|\mathcal{F}^{(r)}|\}\)&lt;/div&gt;" style="rounded=1;arcSize=5;fillColor=#FFFFFF;strokeColor=#8C6418;strokeWidth=1.1;align=center;verticalAlign=middle;spacing=4;html=1;whiteSpace=wrap;fontFamily=Helvetica;fontColor=#1F2933;" vertex="1" parent="1">
          <mxGeometry x="464.0" y="714.0" width="340.0" height="174.0" as="geometry" />
        </mxCell>
        <mxCell id="c19" value="" style="rounded=1;arcSize=2;fillColor=#EDF5F2;strokeColor=#2F6F5E;strokeWidth=1.4;html=1;" vertex="1" parent="1">
          <mxGeometry x="876.0" y="20.0" width="372.0" height="884.0" as="geometry" />
        </mxCell>
        <mxCell id="c20" value="&lt;div style=&quot;font-size:20px;font-weight:bold;color:#2F6F5E;line-height:1.15&quot;&gt;(C) Local Training and&lt;br&gt;Adaptive Quantization&lt;/div&gt;&lt;div style=&quot;font-size:17px;color:#5B6670;margin-top:4px&quot;&gt;selected client \(p\in\mathcal{S}^{(r)}\)&lt;/div&gt;" style="text;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;html=1;whiteSpace=wrap;fontFamily=Helvetica;fontColor=#1F2933;" vertex="1" parent="1">
          <mxGeometry x="922.0" y="26.0" width="280.0" height="80.0" as="geometry" />
        </mxCell>
        <mxCell id="c21" value="" style="shape=line;strokeColor=#2F6F5E;strokeWidth=1;opacity=45;html=1;" vertex="1" parent="1">
          <mxGeometry x="894.0" y="112.0" width="336.0" height="1.0" as="geometry" />
        </mxCell>
        <mxCell id="c22" value="&lt;div style=&quot;font-size:18px;font-weight:bold;color:#1F2933;margin-bottom:6px&quot;&gt;Model download&lt;/div&gt;&lt;div style=&quot;font-size:17px;line-height:34px&quot;&gt;receive \(\mathbf{w}^{(r)}\) and \(b_p\)&lt;/div&gt;" style="rounded=1;arcSize=5;fillColor=#FFFFFF;strokeColor=#2F6F5E;strokeWidth=1.1;align=center;verticalAlign=middle;spacing=4;html=1;whiteSpace=wrap;fontFamily=Helvetica;fontColor=#1F2933;" vertex="1" parent="1">
          <mxGeometry x="892.0" y="128.0" width="340.0" height="106.0" as="geometry" />
        </mxCell>
        <mxCell id="c23" value="&lt;div style=&quot;font-size:18px;font-weight:bold;color:#1F2933;margin-bottom:6px&quot;&gt;Local training on \(\mathcal{D}_p\)&lt;/div&gt;&lt;div style=&quot;font-size:17px;line-height:34px&quot;&gt;\(\mathbf{w}_p^{(\tau+1)}=\mathbf{w}_p^{(\tau)}-\eta\nabla f_p\big(\mathbf{w}_p^{(\tau)}\big),\;\tau\lt E\)&lt;/div&gt;&lt;div style=&quot;font-size:17px;line-height:34px&quot;&gt;\(\mathbf{u}_p=\mathbf{w}_p^{(E)}-\mathbf{w}^{(r)}\)&lt;/div&gt;" style="rounded=1;arcSize=5;fillColor=#FFFFFF;strokeColor=#2F6F5E;strokeWidth=1.1;align=center;verticalAlign=middle;spacing=4;html=1;whiteSpace=wrap;fontFamily=Helvetica;fontColor=#1F2933;" vertex="1" parent="1">
          <mxGeometry x="892.0" y="262.0" width="340.0" height="114.0" as="geometry" />
        </mxCell>
        <mxCell id="c24" value="&lt;div style=&quot;font-size:18px;font-weight:bold;color:#1F2933;margin-bottom:6px&quot;&gt;Stochastic quantization&lt;/div&gt;&lt;div style=&quot;font-size:17px;line-height:34px&quot;&gt;\(\hat{\mathbf{u}}_p=Q_{b_p}(\mathbf{u}_p),\;\;\mathbb{E}[\hat{\mathbf{u}}_p]=\mathbf{u}_p\)&lt;/div&gt;" style="rounded=1;arcSize=5;fillColor=#FFFFFF;strokeColor=#2F6F5E;strokeWidth=1.1;align=center;verticalAlign=middle;spacing=4;html=1;whiteSpace=wrap;fontFamily=Helvetica;fontColor=#1F2933;" vertex="1" parent="1">
          <mxGeometry x="892.0" y="404.0" width="340.0" height="148.0" as="geometry" />
        </mxCell>
        <mxCell id="c25" value="&lt;div style=&quot;font-size:18px;font-weight:bold;color:#1F2933;margin-bottom:6px&quot;&gt;Uplink transmission&lt;/div&gt;&lt;div style=&quot;font-size:17px;line-height:34px&quot;&gt;payload \(b_p\,d+c_q\) bits&lt;/div&gt;" style="rounded=1;arcSize=5;fillColor=#FFFFFF;strokeColor=#2F6F5E;strokeWidth=1.1;align=center;verticalAlign=middle;spacing=4;html=1;whiteSpace=wrap;fontFamily=Helvetica;fontColor=#1F2933;" vertex="1" parent="1">
          <mxGeometry x="892.0" y="580.0" width="340.0" height="106.0" as="geometry" />
        </mxCell>
        <mxCell id="c26" value="&lt;div style=&quot;font-size:18px;font-weight:bold;color:#1F2933;margin-bottom:6px&quot;&gt;Battery update&lt;/div&gt;&lt;div style=&quot;font-size:17px;line-height:34px&quot;&gt;\(C_p^{(r+1)}=C_p-M_p-e_p^{\mathrm{sig}}-\mathbb{1}_p\,\hat{e}_p\)&lt;/div&gt;&lt;div style=&quot;font-size:15.5px;color:#5B6670;margin-top:3px&quot;&gt;\(\mathbb{1}_p=1\) if \(p\in\mathcal{S}^{(r)}\); applied to every client&lt;/div&gt;" style="rounded=1;arcSize=5;fillColor=#FFFFFF;strokeColor=#2F6F5E;strokeWidth=1.1;align=center;verticalAlign=middle;spacing=4;html=1;whiteSpace=wrap;fontFamily=Helvetica;fontColor=#1F2933;" vertex="1" parent="1">
          <mxGeometry x="892.0" y="714.0" width="340.0" height="174.0" as="geometry" />
        </mxCell>
        <mxCell id="c27" value="" style="rounded=1;arcSize=2;fillColor=#F3EFF8;strokeColor=#5E4687;strokeWidth=1.4;html=1;" vertex="1" parent="1">
          <mxGeometry x="1304.0" y="20.0" width="372.0" height="884.0" as="geometry" />
        </mxCell>
        <mxCell id="c28" value="&lt;div style=&quot;font-size:20px;font-weight:bold;color:#5E4687;line-height:1.15&quot;&gt;(D) Credibility-Based&lt;br&gt;Resilient Aggregation&lt;/div&gt;&lt;div style=&quot;font-size:17px;color:#5B6670;margin-top:4px&quot;&gt;federation server&lt;/div&gt;" style="text;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;html=1;whiteSpace=wrap;fontFamily=Helvetica;fontColor=#1F2933;" vertex="1" parent="1">
          <mxGeometry x="1350.0" y="26.0" width="280.0" height="80.0" as="geometry" />
        </mxCell>
        <mxCell id="c29" value="" style="shape=line;strokeColor=#5E4687;strokeWidth=1;opacity=45;html=1;" vertex="1" parent="1">
          <mxGeometry x="1322.0" y="112.0" width="336.0" height="1.0" as="geometry" />
        </mxCell>
        <mxCell id="c30" value="&lt;div style=&quot;font-size:18px;font-weight:bold;color:#1F2933;margin-bottom:6px&quot;&gt;Robust reference&lt;/div&gt;&lt;div style=&quot;font-size:17px;line-height:34px&quot;&gt;\(\mathbf{z}=\operatorname{GeoMed}\{\hat{\mathbf{u}}_p\}_{p\in\mathcal{S}^{(r)}}\)&lt;/div&gt;&lt;div style=&quot;font-size:15.5px;color:#5B6670;margin-top:3px&quot;&gt;Weiszfeld iteration&lt;/div&gt;" style="rounded=1;arcSize=5;fillColor=#FFFFFF;strokeColor=#5E4687;strokeWidth=1.1;align=center;verticalAlign=middle;spacing=4;html=1;whiteSpace=wrap;fontFamily=Helvetica;fontColor=#1F2933;" vertex="1" parent="1">
          <mxGeometry x="1320.0" y="128.0" width="340.0" height="106.0" as="geometry" />
        </mxCell>
        <mxCell id="c31" value="&lt;div style=&quot;font-size:18px;font-weight:bold;color:#1F2933;margin-bottom:6px&quot;&gt;Trust signal&lt;/div&gt;&lt;div style=&quot;font-size:17px;line-height:34px&quot;&gt;\(\varphi_p=\cos(\hat{\mathbf{u}}_p,\mathbf{z})\)&lt;/div&gt;" style="rounded=1;arcSize=5;fillColor=#FFFFFF;strokeColor=#5E4687;strokeWidth=1.1;align=center;verticalAlign=middle;spacing=4;html=1;whiteSpace=wrap;fontFamily=Helvetica;fontColor=#1F2933;" vertex="1" parent="1">
          <mxGeometry x="1320.0" y="262.0" width="340.0" height="114.0" as="geometry" />
        </mxCell>
        <mxCell id="c32" value="&lt;div style=&quot;font-size:18px;font-weight:bold;color:#1F2933;margin-bottom:6px&quot;&gt;Reputation update&lt;/div&gt;&lt;div style=&quot;font-size:17px;line-height:34px&quot;&gt;\(\rho_p^{(r+1)}=\mu\,\rho_p+(1-\mu)\max\{0,\varphi_p\}\)&lt;/div&gt;" style="rounded=1;arcSize=5;fillColor=#FFFFFF;strokeColor=#5E4687;strokeWidth=1.1;align=center;verticalAlign=middle;spacing=4;html=1;whiteSpace=wrap;fontFamily=Helvetica;fontColor=#1F2933;" vertex="1" parent="1">
          <mxGeometry x="1320.0" y="404.0" width="340.0" height="148.0" as="geometry" />
        </mxCell>
        <mxCell id="c33" value="&lt;div style=&quot;font-size:18px;font-weight:bold;color:#1F2933;margin-bottom:6px&quot;&gt;Reputation gate&lt;/div&gt;&lt;div style=&quot;font-size:17px;line-height:34px&quot;&gt;\(\mathcal{A}^{(r)}=\{p\in\mathcal{S}^{(r)}:\rho_p^{(r+1)}\ge\rho_{\min}\}\)&lt;/div&gt;&lt;div style=&quot;font-size:15.5px;color:#5B6670;margin-top:3px&quot;&gt;rejected clients are barred&lt;/div&gt;" style="rounded=1;arcSize=5;fillColor=#FFFFFF;strokeColor=#5E4687;strokeWidth=1.1;align=center;verticalAlign=middle;spacing=4;html=1;whiteSpace=wrap;fontFamily=Helvetica;fontColor=#1F2933;" vertex="1" parent="1">
          <mxGeometry x="1320.0" y="580.0" width="340.0" height="106.0" as="geometry" />
        </mxCell>
        <mxCell id="c34" value="&lt;div style=&quot;font-size:18px;font-weight:bold;color:#1F2933;margin-bottom:6px&quot;&gt;Reputation-weighted aggregation&lt;/div&gt;&lt;div style=&quot;font-size:17px;line-height:34px&quot;&gt;\(\mathbf{w}^{(r+1)}=\mathbf{w}^{(r)}+\sum_{p\in\mathcal{A}^{(r)}}\omega_p\,c_p\,\hat{\mathbf{u}}_p\)&lt;/div&gt;&lt;div style=&quot;font-size:17px;line-height:34px&quot;&gt;\(\omega_p=\rho_p^{(r+1)}\big/\sum_{q\in\mathcal{A}^{(r)}}\rho_q^{(r+1)}\)&lt;/div&gt;&lt;div style=&quot;font-size:17px;line-height:34px&quot;&gt;\(c_p=\min\{1,\tau/\|\hat{\mathbf{u}}_p\|\}\)&lt;/div&gt;&lt;div style=&quot;font-size:15.5px;color:#5B6670;margin-top:3px&quot;&gt;\(\tau\): median norm of the received updates&lt;/div&gt;" style="rounded=1;arcSize=5;fillColor=#FFFFFF;strokeColor=#5E4687;strokeWidth=1.1;align=center;verticalAlign=middle;spacing=4;html=1;whiteSpace=wrap;fontFamily=Helvetica;fontColor=#1F2933;" vertex="1" parent="1">
          <mxGeometry x="1320.0" y="714.0" width="340.0" height="174.0" as="geometry" />
        </mxCell>
        <mxCell id="c35" value="" style="edgeStyle=none;exitX=0.5;exitY=1;entryX=0.5;entryY=0;endArrow=block;endSize=7;endFill=1;html=1;strokeColor=#3F4A54;strokeWidth=1.6;rounded=0;" edge="1" parent="1" source="c6" target="c7">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="c36" value="" style="edgeStyle=none;exitX=0.5;exitY=1;entryX=0.5;entryY=0;endArrow=block;endSize=7;endFill=1;html=1;strokeColor=#3F4A54;strokeWidth=1.6;rounded=0;" edge="1" parent="1" source="c7" target="c8">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="c37" value="" style="edgeStyle=none;exitX=0.5;exitY=1;entryX=0.5;entryY=0;endArrow=block;endSize=7;endFill=1;html=1;strokeColor=#3F4A54;strokeWidth=1.6;rounded=0;" edge="1" parent="1" source="c8" target="c9">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="c38" value="" style="edgeStyle=none;exitX=0.5;exitY=1;entryX=0.5;entryY=0;endArrow=block;endSize=7;endFill=1;html=1;strokeColor=#3F4A54;strokeWidth=1.6;rounded=0;" edge="1" parent="1" source="c9" target="c10">
